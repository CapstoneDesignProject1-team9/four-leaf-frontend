# Dockerfile.dev — 로컬 개발용 (Vite dev server + HMR)
# 프로덕션 빌드가 아니라 개발 서버를 실행합니다.
# 소스 코드는 docker-compose.dev.yml의 volume mount로 주입됩니다.

FROM node:20-alpine

WORKDIR /app

# 의존성 먼저 복사 (레이어 캐시 활용)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# 소스는 volume mount로 들어오므로 COPY 불필요
# (docker-compose.dev.yml에서 ../four-laef-frontend:/app 마운트)

EXPOSE 3000

# Vite dev server (--host로 컨테이너 외부에서 접근 허용)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
